  <script>
    const PRODUCTS = {
      'BK-001': { sku: 'BK-001', name: 'แซนด์วิชแฮมชีส', piecesPerTray: 12, prepMin: 45, round: 'กะกลางคืน (ทับ 1)', stockPieces: 24 },
      'BK-002': { sku: 'BK-002', name: 'ขนมปังกะโหลก (แถว)', piecesPerTray: 6, prepMin: 120, round: 'รอบเช้า (ทับ 1)', stockPieces: 18 },
      'BK-003': { sku: 'BK-003', name: 'ครัวซองต์เนยสด', piecesPerTray: 15, prepMin: 90, round: 'รอบเช้า (ทับ 1)', stockPieces: 15 },
      'BK-004': { sku: 'BK-004', name: 'เดนิชลูกเกด', piecesPerTray: 12, prepMin: 90, round: 'รอบบ่าย (ทับ 1)', stockPieces: 24 }
    };

    const STATUS_LABELS = {
      new_alert: 'ออเดอร์ใหม่ (รอรับ)',
      accepted: 'รับออเดอร์แล้ว',
      preparing: 'กำลังเตรียม/อบ',
      ready: 'พร้อมส่ง',
      shortage_alert: 'ของไม่พอ / รอหัวหน้า',
      cn_flagged: 'ทำ CN แล้ว'
    };

    let currentRole = 'staff';
    let currentFilter = 'all';
    let activeShortageOrderId = null;
    let latestToastOrderId = null;
    let supabaseClient = null;
    let isUsingSupabase = false;
    let realtimeChannel = null;

    let orders = [
      {
        id: 'ord-101',
        order_no: 'MKP-O2O-001',
        channel: 'Makro Pro - O2O',
        product_code: 'BK-003',
        product_name: 'ครัวซองต์เนยสด',
        unit_type: 'tray',
        quantity: 3,
        total_pieces: 45,
        batch_round: 'รอบเช้า (ทับ 1)',
        customer_note: 'ลูกค้าสั่งจัดเบรกช่วงเช้า',
        latest_note: '',
        has_tray_item: true,
        delivery_in_mins: 110,
        status: 'new_alert',
        created_at: new Date().toISOString()
      },
      {
        id: 'ord-102',
        order_no: 'MKP-O2O-002',
        channel: 'Makro Pro - O2O',
        product_code: 'BK-001',
        product_name: 'แซนด์วิชแฮมชีส',
        unit_type: 'piece',
        quantity: 12,
        total_pieces: 12,
        batch_round: 'กะกลางคืน (ทับ 1)',
        customer_note: 'รับหน้าร้าน',
        latest_note: '',
        has_tray_item: false,
        delivery_in_mins: 65,
        status: 'preparing',
        created_at: new Date(Date.now() - 12 * 60000).toISOString()
      }
    ];

    let logs = [
      { time: 'เริ่มต้น', role: 'ระบบ', text: 'พร้อมใช้งานโหมดเดโมและเชื่อมต่อ Supabase จริง' }
    ];

    function playAlertSound() {
      if (!document.getElementById('sound-toggle').checked) return;
      try {
        const ctx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(880, ctx.currentTime);
        osc.frequency.setValueAtTime(1174.66, ctx.currentTime + 0.12);
        gain.gain.setValueAtTime(0.15, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.35);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + 0.35);
      } catch (e) {}
    }

    function setRole(role) {
      currentRole = role;
      document.querySelectorAll('.role-btn').forEach(btn => {
        btn.className = 'role-btn px-3 py-1.5 rounded-lg text-xs sm:text-sm font-semibold transition text-slate-600 hover:bg-white';
      });
      document.getElementById(`role-${role}`).className =
        'role-btn px-3 py-1.5 rounded-lg text-xs sm:text-sm font-semibold transition bg-amber-500 text-white shadow-sm';
      renderAll();
    }

    function setFilter(flt) {
