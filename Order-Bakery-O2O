      if (!activeShortageOrderId) return;
      const reason = document.getElementById('shortage-reason-select').value;
      updateOrderStatus(activeShortageOrderId, statusType, reason);
      closeShortageModal();
    }

    function addLog(role, text) {
      const timeStr = new Date().toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' });
      logs.unshift({ time: timeStr, role, text });
      if (logs.length > 30) logs.pop();
