    function openShortageModal(orderId) {
      activeShortageOrderId = orderId;
      const ord = orders.find(o => o.id === orderId);
      const prod = PRODUCTS[ord.product_code] || PRODUCTS['BK-003'];
      document.getElementById('shortage-order-label').textContent =
        `บิล ${ord.order_no} (${prod.name} • ${ord.quantity} ${ord.unit_type === 'tray' ? 'ถาด' : 'ชิ้น'})`;
      const cnBtn = document.getElementById('btn-confirm-cn');
      cnBtn.disabled = currentRole !== 'supervisor';
      cnBtn.classList.toggle('opacity-40', currentRole !== 'supervisor');
      document.getElementById('shortage-modal').classList.remove('hidden');
