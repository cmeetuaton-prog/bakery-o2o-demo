    function openSupabaseModal() {
      document.getElementById('supabase-modal').classList.remove('hidden');
    }
    function closeSupabaseModal() {
      document.getElementById('supabase-modal').classList.add('hidden');
    }
    function useLocalDemoMode() {
      isUsingSupabase = false;
      if (realtimeChannel && supabaseClient) {
        supabaseClient.removeChannel(realtimeChannel);
      }
      document.getElementById('btn-refresh-sb').classList.add('hidden');
      document.getElementById('mode-badge').textContent = 'โหมดเดโมในเครื่อง (พร้อมเล่นทันที)';
      document.getElementById('mode-badge').className = 'px-2.5 py-0.5 rounded-full font-semibold bg-emerald-600 text-white';
