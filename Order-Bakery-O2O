      document.getElementById('toast-title').textContent =
        `${order.order_no} • ${prod.name} (${order.quantity} ${order.unit_type === 'tray' ? 'ถาด' : 'ชิ้น'})`;
      document.getElementById('toast-desc').textContent =
        `รอบแนะนำ: ${prod.round} • เวลาเตรียม ~${prod.prepMin} นาที • ส่งมอบใน ~${order.delivery_in_mins} นาที`;
      document.getElementById('live-toast').classList.remove('hidden');
