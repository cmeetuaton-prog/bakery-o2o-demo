              </div>
            </div>

            <div class="mt-4 pt-3 border-t border-slate-100 flex flex-wrap items-center justify-between gap-2">
              <div class="flex flex-wrap gap-1.5">
                ${ord.status === 'new_alert' ? `
                  <button onclick="updateOrderStatus('${ord.id}', 'accepted')"
                    class="px-3.5 py-1.5 rounded-xl bg-amber-500 hover:bg-amber-600 text-white text-xs font-bold shadow-sm">
                    รับออเดอร์
                  </button>
                ` : ''}
                ${['new_alert', 'accepted'].includes(ord.status) ? `
                  <button onclick="updateOrderStatus('${ord.id}', 'preparing')"
                    class="px-3.5 py-1.5 rounded-xl bg-sky-600 hover:bg-sky-700 text-white text-xs font-bold">
                    เริ่มเตรียม/อบ
                  </button>
                ` : ''}
                ${ord.status === 'preparing' ? `
                  <button onclick="updateOrderStatus('${ord.id}', 'ready')"
                    class="px-3.5 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold">
                    แพ็กพร้อมส่ง
                  </button>
                ` : ''}
              </div>

              ${!['ready', 'cn_flagged'].includes(ord.status) ? `
                <button onclick="openShortageModal('${ord.id}')"
                  class="px-3 py-1.5 rounded-xl border border-rose-300 text-rose-700 hover:bg-rose-50 text-xs font-semibold">
                  แจ้งของไม่พอ / ตรวจสอบ CN
                </button>
              ` : ''}
            </div>
          </div>
        `;
      }).join('');
    }

    function renderProductionSummary() {
      const container = document.getElementById('production-summary');
      container.innerHTML = Object.values(PRODUCTS).map(prod => {
        const activeOrders = orders.filter(o => o.product_code === prod.sku && !['cn_flagged', 'ready'].includes(o.status));
        const neededPieces = activeOrders.reduce((sum, o) => sum + Number(o.total_pieces || 0), 0);
        const shortagePieces = Math.max(0, neededPieces - prod.stockPieces);

        return `
          <div class="p-3 rounded-xl bg-amber-50/70 border border-amber-200/80">
            <div class="flex items-center justify-between gap-2">
              <span class="text-xs font-bold text-slate-900">${prod.name}</span>
              <span class="text-[11px] font-semibold text-amber-800">${prod.round}</span>
            </div>
            <div class="mt-1.5 flex items-center justify-between text-xs">
              <span class="text-slate-600">สต็อกพร้อมส่ง: <b>${prod.stockPieces}</b> ชิ้น</span>
              <span class="text-slate-600">ยอดสั่งค้าง: <b>${neededPieces}</b> ชิ้น</span>
            </div>
            <div class="mt-1 text-xs font-semibold ${shortagePieces > 0 ? 'text-rose-600' : 'text-emerald-700'}">
              ${shortagePieces > 0
                ? `ต้องวางแผนผลิตเพิ่มอีก ${shortagePieces} ชิ้น (${Math.ceil(shortagePieces / prod.piecesPerTray)} ถาด)`
                : 'สต็อกเพียงพอสำหรับออเดอร์ที่ค้างอยู่'}
            </div>
          </div>
        `;
      }).join('');
    }

    function renderLogs() {
      const container = document.getElementById('activity-logs');
      container.innerHTML = logs.map(l => `
        <div class="p-2 rounded-lg bg-slate-50 border border-slate-100">
          <div class="flex items-center justify-between text-[11px] text-slate-400">
            <span class="font-semibold text-slate-600">${l.role}</span>
            <span>${l.time}</span>
          </div>
          <p class="text-slate-700 mt-0.5">${l.text}</p>
        </div>
      `).join('');
    }

    renderAll();
  </script>
</body>
</html>
