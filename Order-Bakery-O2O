    async function connectSupabase() {
      let url = document.getElementById('sb-url').value.trim().replace(/\/+$/, '').replace(/\/rest\/v1$/, '');
      const key = document.getElementById('sb-key').value.trim();
      if (!url || !key || !window.supabase) return;

      supabaseClient = window.supabase.createClient(url, key);
      isUsingSupabase = true;
      document.getElementById('btn-refresh-sb').classList.remove('hidden');
      document.getElementById('mode-badge').textContent = 'เชื่อมต่อ Supabase แล้ว (ซิงก์จริง)';
      document.getElementById('mode-badge').className = 'px-2.5 py-0.5 rounded-full font-semibold bg-sky-600 text-white';
      closeSupabaseModal();

      await syncFromSupabase(false);
      subscribeRealtimeOrders();
    }

    async function syncFromSupabase(notifyNew = false) {
      if (!isUsingSupabase || !supabaseClient) return;
      try {
        const { data: sbOrders, error: ordErr } = await supabaseClient
          .from('orders')
          .select('*')
          .order('created_at', { ascending: false });

        if (ordErr) throw ordErr;

        const { data: sbItems } = await supabaseClient
          .from('order_items')
          .select('*');

        const { data: sbProducts } = await supabaseClient
          .from('products')
          .select('*');

        const prodById = {};
        (sbProducts || []).forEach(p => { prodById[p.id] = p; });

        const itemByOrder = {};
        (sbItems || []).forEach(it => {
          if (!itemByOrder[it.order_id]) itemByOrder[it.order_id] = it;
        });

        const prevIds = new Set(orders.map(o => o.id));

        orders = (sbOrders || []).map(o => {
          const it = itemByOrder[o.id];
          const p = it ? prodById[it.product_id] : null;
          const sku = p?.sku_code || 'BK-003';
          const fallbackProd = PRODUCTS[sku] || PRODUCTS['BK-003'];
          const unitType = it?.unit_type || (o.has_tray_item ? 'tray' : 'piece');
          const qty = it?.quantity || 1;
          const totalPieces = it?.total_pieces || (unitType === 'tray' ? qty * fallbackProd.piecesPerTray : qty);
          const deliveryMins = Math.max(15, Math.round((new Date(o.delivery_time) - new Date()) / 60000));

          return {
            id: o.id,
            order_no: o.order_no,
            channel: o.channel || 'Makro Pro - O2O',
            product_code: sku,
            product_name: p?.name || fallbackProd.name,
            unit_type: unitType,
            quantity: qty,
            total_pieces: totalPieces,
            batch_round: it?.batch_round || fallbackProd.round,
            customer_note: o.customer_note || '',
            latest_note: o.latest_note || '',
            has_tray_item: Boolean(o.has_tray_item),
            delivery_in_mins: Number.isFinite(deliveryMins) ? deliveryMins : 90,
            status: o.status || 'new_alert',
            created_at: o.created_at
          };
        });

        if (notifyNew && orders.length > 0 && !prevIds.has(orders[0].id)) {
          const newest = orders[0];
          showToast(newest, PRODUCTS[newest.product_code] || PRODUCTS['BK-003']);
          playAlertSound();
        }

        const { data: sbLogs } = await supabaseClient
          .from('order_status_logs')
          .select('*')
          .order('created_at', { ascending: false })
          .limit(25);

        if (sbLogs && sbLogs.length > 0) {
          logs = sbLogs.map(l => ({
            time: new Date(l.created_at).toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' }),
            role: l.action_by_role,
            text: `${l.action_type}${l.reason_note ? ' — ' + l.reason_note : ''}`
          }));
        }

        addLog('Supabase', `ซิงก์ข้อมูลออเดอร์สำเร็จ (${orders.length} รายการ)`);
        renderAll();
      } catch (err) {
        addLog('Supabase Error', err.message || 'ไม่สามารถอ่านข้อมูลจาก Supabase ได้');
        renderLogs();
      }
    }

    function subscribeRealtimeOrders() {
      if (!isUsingSupabase || !supabaseClient) return;
      if (realtimeChannel) supabaseClient.removeChannel(realtimeChannel);
      realtimeChannel = supabaseClient
        .channel('bakery-orders-realtime')
        .on('postgres_changes', { event: '*', schema: 'public', table: 'orders' }, () => {
          syncFromSupabase(true);
        })
        .subscribe();
    }

    // --- Create Order (Local + Supabase) ---
    function handleCreateOrder(e) {
      e.preventDefault();
      const code = document.getElementById('sim-product').value;
      const unit = document.getElementById('sim-unit').value;
      const qty = Math.max(1, parseInt(document.getElementById('sim-qty').value || '1', 10));
      const note = document.getElementById('sim-note').value.trim();
      addNewOrder(code, unit, qty, note);
      document.getElementById('sim-note').value = '';
    }

    function triggerDemoOrder(forceTray) {
      const codes = Object.keys(PRODUCTS);
      const code = forceTray ? 'BK-003' : codes[Math.floor(Math.random() * codes.length)];
      const unit = forceTray ? 'tray' : (Math.random() > 0.4 ? 'tray' : 'piece');
      const qty = unit === 'tray' ? (Math.floor(Math.random() * 3) + 2) : (Math.floor(Math.random() * 12) + 6);
      addNewOrder(code, unit, qty, forceTray ? 'ออเดอร์ถาดด่วนจาก Makro Pro' : 'ออเดอร์จำลอง O2O');
    }

    async function addNewOrder(productCode, unitType, quantity, note = '') {
      const prod = PRODUCTS[productCode];
      const totalPieces = unitType === 'tray' ? quantity * prod.piecesPerTray : quantity;
      const orderNo = `MKP-O2O-${String(Math.floor(100 + Math.random() * 899))}`;
      const deliveryMins = unitType === 'tray' ? 120 : 60;
      const deliveryIso = new Date(Date.now() + deliveryMins * 60000).toISOString();

      const localOrder = {
        id: 'ord-' + Date.now(),
        order_no: orderNo,
        channel: 'Makro Pro - O2O',
        product_code: productCode,
        product_name: prod.name,
        unit_type: unitType,
        quantity,
        total_pieces: totalPieces,
        batch_round: prod.round,
        customer_note: note,
        latest_note: '',
        has_tray_item: unitType === 'tray',
        delivery_in_mins: deliveryMins,
        status: 'new_alert',
        created_at: new Date().toISOString()
      };

      if (isUsingSupabase && supabaseClient) {
        try {
          const { data: insertedOrder, error: ordErr } = await supabaseClient
            .from('orders')
            .insert([{
              order_no: orderNo,
              channel: 'Makro Pro - O2O',
              customer_note: note || 'ออเดอร์จาก Makro Pro / O2O',
              delivery_time: deliveryIso,
              has_tray_item: unitType === 'tray',
              status: 'new_alert'
            }])
            .select()
            .single();

          if (ordErr) throw ordErr;

          const { data: dbProd } = await supabaseClient
            .from('products')
            .select('id')
            .eq('sku_code', productCode)
            .maybeSingle();

          await supabaseClient.from('order_items').insert([{
            order_id: insertedOrder.id,
            product_id: dbProd?.id || null,
            unit_type: unitType,
            quantity,
            total_pieces: totalPieces,
            batch_round: prod.round,
            item_status: 'pending'
          }]);

          await supabaseClient.from('order_status_logs').insert([{
            order_id: insertedOrder.id,
            action_by_role: 'o2o_sim',
            action_type: 'create_demo',
            reason_note: `${orderNo}: ${prod.name} (${quantity} ${unitType === 'tray' ? 'ถาด' : 'ชิ้น'} / ${totalPieces} ชิ้น)`
          }]);

          await syncFromSupabase(false);
          showToast({ ...localOrder, id: insertedOrder.id }, prod);
          playAlertSound();
          return;
        } catch (err) {
          addLog('Supabase Error', `บันทึกออเดอร์ไม่สำเร็จ: ${err.message}`);
        }
      }

      orders.unshift(localOrder);
      addLog('O2O จำลอง', `ออเดอร์ใหม่ ${orderNo}: ${prod.name} (${quantity} ${unitType === 'tray' ? 'ถาด' : 'ชิ้น'} / รวม ${totalPieces} ชิ้น)`);
      showToast(localOrder, prod);
      playAlertSound();
      renderAll();
    }

    async function updateOrderStatus(orderId, newStatus, note = '') {
      const ord = orders.find(o => o.id === orderId);
      if (!ord) return;
      ord.status = newStatus;
      if (note) ord.latest_note = note;

      const roleLabel = currentRole === 'supervisor' ? 'หัวหน้างาน' : (currentRole === 'staff' ? 'พนักงานเบเกอรี' : 'O2O จำลอง');

      if (isUsingSupabase && supabaseClient && !String(orderId).startsWith('ord-')) {
        try {
          await supabaseClient
            .from('orders')
            .update({ status: newStatus, latest_note: note || ord.latest_note })
            .eq('id', orderId);

          await supabaseClient.from('order_status_logs').insert([{
            order_id: orderId,
            action_by_role: currentRole,
            action_type: newStatus,
            reason_note: note || `${ord.order_no} -> ${STATUS_LABELS[newStatus] || newStatus}`
          }]);
        } catch (err) {
          addLog('Supabase Error', err.message);
        }
      }

      addLog(roleLabel, `${ord.order_no}: ${STATUS_LABELS[newStatus] || newStatus}${note ? ' — ' + note : ''}`);
      renderAll();
    }

    // --- Toast & Shortage Modal ---
